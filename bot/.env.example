# BotFather's BOT Token
TELEGRAM_BOT_TOKEN=inserisci_qui_il_token_da_BotFather

# PSQL/pgvector connection URL
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/DB_NAME?sslmode=disable

# Deve restare lo stesso modello usato in fase di ingestion (stessa
# variabile in ../ingestion/.env): gli embedding delle query devono
# vivere nello stesso spazio vettoriale dei chunk già scritti. Se
# ometti questa variabile, usa il default del pacchetto ingestion
# (microsoft/harrier-oss-v1-0.6b).
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b

# Ollama, per vision (identificazione oggetto da foto) e generazione
# della risposta RAG. Deve essere un modello multimodale già scaricato
# in Ollama (`ollama pull <modello>`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
