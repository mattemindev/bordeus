# PSQL/pgvector connection URL
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/DB_NAME?sslmode=disable

# Opzionale: livello di log (DEBUG, INFO, WARNING, ERROR). Default: INFO.
LOG_LEVEL=INFO

# Opzionale: modello sentence-transformers per l'embedding. Default se
# omesso: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# (768 dimensioni — vedi embed.EMBEDDING_DIM). Un modello con dimensione
# diversa fa fallire subito get_embeddings() con un errore esplicito,
# invece di scrivere dati incompatibili su Postgres.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
