# PSQL/pgvector connection URL
DATABASE_URL=postgres://USERNAME:PASSWORD@localhost:5432/DB_NAME?sslmode=disable

# Opzionale: livello di log. Oltre ai livelli standard accetta TRACE (5),
# il livello dei contenuti verbosi (prompt, contesto). Default: INFO.
LOG_LEVEL=INFO

# Modello di embedding. Deve restare lo stesso usato dal bot (stessa
# variabile in ../bot/.env): i chunk scritti da qui e le query del bot
# devono vivere nello stesso spazio vettoriale. Un modello con una
# dimensione diversa da quella attesa fa fallire subito get_embeddings()
# con un errore esplicito, invece di scrivere silenziosamente dati
# incompatibili su Postgres.
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b

# --- Estrazione del calendario da immagine -----------------------------
# Usate SOLO dal comando `bordeus-ingest extract-calendario`, non da
# `sync`. Endpoint OpenAI-compatibile: va bene Ollama in locale o un
# provider remoto (OpenRouter, ecc.), scelto qui senza toccare il codice.
#
# Il modello deve supportare sia le immagini sia l'output strutturato
# (response_format): non tutti i modelli multimodali lo fanno, e uno che
# non lo supporta fallisce con un errore esplicito.
INGEST_VISION_BASE_URL=http://localhost:11434/v1
INGEST_VISION_MODEL=qwen3.5:9b
# Ollama non la verifica, un provider remoto sì. Non committare mai una
# chiave vera: questo file è .env.example, quello vero (.env) è in
# .gitignore.
INGEST_VISION_API_KEY=ollama
